#include <iostream>
#include <string>
#include <iomanip>
#include <algorithm>

using namespace std;

// Khai báo cấu trúc Flower
struct Flower {
    string name;
    double price;
    int quantity;
    string type;
};

// Hàm hỗ trợ chuyển chuỗi thành chữ thường để so sánh không phân biệt hoa/thường
string toLower(string str) {
    transform(str.begin(), str.end(), str.begin(), ::tolower);
    return str;
}

int main() {
    Flower flowers[20];
    int n;

    // Nhập số lượng hoa (1 <= N <= 20)
    do {
        cout << "How many flowers? (1-20): ";
        cin >> n;
    } while (n < 1 || n > 20);

    // 1. Input information for N flowers
    for (int i = 0; i < n; i++) {
        cout << "\nFlower " << (i + 1) << ":" << endl;
        cout << "  Name: ";
        cin >> flowers[i].name;

        // Validate price > 0
        do {
            cout << "  Price (> 0): ";
            cin >> flowers[i].price;
        } while (flowers[i].price <= 0);

        // Validate quantity >= 0
        do {
            cout << "  Quantity (>= 0): ";
            cin >> flowers[i].quantity;
        } while (flowers[i].quantity < 0);

        cout << "  Type: ";
        cin >> flowers[i].type;
    }


    // 2. Display the list of flowers
    cout << "\n===== FLOWER SHOP =====" << endl;
    cout << left << setw(5) << "No" 
         << setw(15) << "Name" 
         << setw(10) << "Price" 
         << setw(8) << "Qty" 
         << setw(15) << "Type" << endl;
    cout << "------------------------------------------------" << endl;
    for (int i = 0; i < n; i++) {
        cout << left << setw(5) << (i + 1)
             << setw(15) << flowers[i].name
             << setw(10) << fixed << setprecision(1) << flowers[i].price
             << setw(8) << flowers[i].quantity
             << setw(15) << flowers[i].type << endl;
    }

    // 3. Find most expensive, cheapest, total quantity, and average price
    int maxIdx = 0, minIdx = 0;
    int totalQty = 0;
    double totalPrice = 0;

    for (int i = 0; i < n; i++) {
        if (flowers[i].price > flowers[maxIdx].price) maxIdx = i;
        if (flowers[i].price < flowers[minIdx].price) minIdx = i;
        totalQty += flowers[i].quantity;
        totalPrice += flowers[i].price;
    }
    double avgPrice = totalPrice / n;

    cout << "\n----- ANALYSIS -----" << endl;
    cout << "Most expensive flower : " << flowers[maxIdx].name << " (" << flowers[maxIdx].price << ")" << endl;
    cout << "Cheapest flower       : " << flowers[minIdx].name << " (" << flowers[minIdx].price << ")" << endl;
    cout << "Total quantity        : " << totalQty << endl;
    cout << "Average price         : " << fixed << setprecision(1) << avgPrice << endl;

    // 4. Count how many flowers belong to each type
    cout << "\n----- COUNT BY TYPE -----" << endl;
    for (int i = 0; i < n; i++) {
        bool alreadyCounted = false;
        for (int j = 0; j < i; j++) {
            if (toLower(flowers[i].type) == toLower(flowers[j].type)) {
                alreadyCounted = true;
                break;
            }
        }
        if (!alreadyCounted) {
            int count = 0;
            for (int k = 0; k < n; k++) {
                if (toLower(flowers[k].type) == toLower(flowers[i].type)) {
                    count++;
                }
            }
            cout << left << setw(10) << flowers[i].type << ": " << count << endl;
        }
    }


    // 5. Search for a flower by name
    string searchName;
    cout << "\nEnter flower name to search: ";
    cin >> searchName;

    bool found = false;
    for (int i = 0; i < n; i++) {
        if (toLower(flowers[i].name) == toLower(searchName)) {
            cout << "Found!" << endl;
            cout << "Price: " << flowers[i].price << endl;
            cout << "Quantity: " << flowers[i].quantity << endl;
            cout << "Type: " << flowers[i].type << endl;
            found = true;
            break;
        }
    }
    if (!found) {
        cout << "Flower not found!" << endl;
    }

    return 0;
}