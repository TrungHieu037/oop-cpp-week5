#include <iostream>
using namespace std;

int main() {
    // Mảng điểm mẫu của 10 học sinh
    double scores[10] = {4.5, 8.0, 7.5, 4.5, 9.0, 6.0, 7.5, 8.0, 9.5, 9.0};
    int n = 10;

    // 1. Count Excellent Students (>= 9.0)
    cout << "=== Bài 1 ===" << endl;
    int countExc = 0;
    for (int i = 0; i < n; i++) {
        if (scores[i] >= 9.0) countExc++;
    }
    cout << "Number of excellent students: " << countExc << endl;



    // 2. Count Students in Range [a, b]
    cout << "\n=== Bài 2 ===" << endl;
    double minVal = 6, maxVal = 8;
    int countRange = 0;
    for (int i = 0; i < n; i++) {
        if (scores[i] >= minVal && scores[i] <= maxVal) countRange++;
    }
    cout << "Students in range: " << countRange << endl;



    // 3. Find Students Above Average
    cout << "\n=== Bài 3 ===" << endl;
    double sum = 0;
    for (int i = 0; i < n; i++) sum += scores[i];
    double avg = sum / n;
    cout << "Average score: " << avg << endl;
    cout << "Students above average:" << endl;
    for (int i = 0; i < n; i++) {
        if (scores[i] > avg) cout << "Student " << (i + 1) << ": " << scores[i] << endl;
    }





    // 4. Find Second Highest Score
    cout << "\n=== Bài 4 ===" << endl;
    double max1 = -1, max2 = -1;
    for (int i = 0; i < n; i++) {
        if (scores[i] > max1) {
            max2 = max1;
            max1 = scores[i];
        } else if (scores[i] > max2 && scores[i] < max1) {
            max2 = scores[i];
        }
    }
    cout << "Highest score: " << max1 << endl;
    cout << "Second highest score: " << max2 << endl;



    // 5. Search for a Score
    cout << "\n=== Bài 5 ===" << endl;
    double searchVal = 7.5;
    cout << "Found at:" << endl;
    for (int i = 0; i < n; i++) {
        if (scores[i] == searchVal) cout << "Student " << (i + 1) << endl;
    }


    // 6. Count Score Frequency
    cout << "\n=== Bài 6 ===" << endl;
    double freqVal = 8.0;
    int freq = 0;
    for (int i = 0; i < n; i++) {
        if (scores[i] == freqVal) freq++;
    }
    cout << "Score " << freqVal << " appears " << freq << " times." << endl;


    // 7. Find First Failing Student (< 5.0)
    cout << "\n=== Bài 7 ===" << endl;
    bool hasFail = false;
    for (int i = 0; i < n; i++) {
        if (scores[i] < 5.0) {
            cout << "First failing student:\nStudent " << (i + 1) << ": " << scores[i] << endl;
            hasFail = true;
            break;
        }
    }
    if (!hasFail) cout << "All students pass!" << endl;

    // 8. Compare Adjacent Students
    cout << "\n=== Bài 8 ===" << endl;
    for (int i = 1; i < n; i++) {
        if (scores[i] > scores[i - 1]) {
            cout << "Student " << (i + 1) << " improved compared to Student " << i << endl;
        }
    }

    // 9. Find Longest Pass Streak (>= 5.0)
    cout << "\n=== Bài 9 ===" << endl;
    int maxStreak = 0, currentStreak = 0;
    for (int i = 0; i < n; i++) {
        if (scores[i] >= 5.0) {
            currentStreak++;
            if (currentStreak > maxStreak) maxStreak = currentStreak;
        } else {
            currentStreak = 0;
        }
    }
    cout << "Longest pass streak: " << maxStreak << " students" << endl;

    // 10. Score Distribution
    cout << "\n=== Bài 10 ===" << endl;
    int r1 = 0, r2 = 0, r3 = 0, r4 = 0, r5 = 0;
    for (int i = 0; i < n; i++) {
        if (scores[i] < 5.0) r1++;
        else if (scores[i] < 6.5) r2++;
        else if (scores[i] < 8.0) r3++;
        else if (scores[i] < 9.0) r4++;
        else r5++;
    }
    cout << "0   - <5   : " << r1 << endl;
    cout << "5   - <6.5 : " << r2 << endl;
    cout << "6.5 - <8   : " << r3 << endl;
    cout << "8   - <9   : " << r4 << endl;
    cout << "9   - 10   : " << r5 << endl;

    return 0;
}


